# =============================================================================
# FinAdvisor - LOCAL DEVELOPMENT ENVIRONMENT
# =============================================================================
# Copy this file to .env.local and update the values
# This file is for running the application locally with Docker Compose
#
# USAGE: cp .env.local.example .env.local

# =============================================================================
# 🔑 LLM API KEY (ELIGE UNA OPCIÓN)
# =============================================================================

# Opción 1: OpenAI (Recomendado para desarrollo local - más barato)
# Obtén tu API key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Opción 2: Anthropic Direct API
# Obtén tu API key en: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Opción 3: AWS Bedrock (Para probar localmente con credenciales temporales)
# AWS_ACCESS_KEY_ID=your-access-key-here
# AWS_SECRET_ACCESS_KEY=your-secret-key-here
# AWS_SESSION_TOKEN=your-session-token-here
# AWS_REGION=us-east-1

# =============================================================================
# 🤖 CONFIGURACIÓN DEL MODELO
# =============================================================================

# Provider: openai, anthropic, bedrock
MODEL_PROVIDER=openai

# Modelo según el provider:
# - OpenAI: gpt-4o-mini (recomendado local), gpt-4o, gpt-4-turbo
# - Anthropic: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
# - Bedrock: anthropic.claude-3-5-sonnet-20241022-v2:0, anthropic.claude-3-5-haiku-20241022-v1:0
MODEL_NAME=gpt-4o-mini

# Timeout para llamadas LLM (segundos)
API_TIMEOUT=30

# =============================================================================
# 💾 BASE DE DATOS (Docker Compose - NO CAMBIAR)
# =============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=finadvisor
DB_USER=postgres
DB_PASSWORD=postgres

# =============================================================================
# 🔴 REDIS (Docker Compose - NO CAMBIAR)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379

# =============================================================================
# 🌐 API SERVER (Docker Compose - NO CAMBIAR)
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000

# =============================================================================
# 📊 FRONTEND (Streamlit)
# =============================================================================
# URL del backend API (usar localhost desde tu navegador)
API_ENDPOINT=http://localhost:8000

# =============================================================================
# 🔧 CONFIGURACIÓN AVANZADA (Opcional)
# =============================================================================

# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# RAG (Búsqueda semántica de productos)
RAG_ENABLED=true
RAG_EMBEDDING_DIM=384
RAG_SIMILARITY_THRESHOLD=0.3

# =============================================================================
# 📊 LANGSMITH - EVALUACIÓN Y TRAZABILIDAD (Opcional pero recomendado)
# =============================================================================
# Obtén tu API key desde https://smith.langchain.com/settings

# Requerido: Tu API key de LangSmith
# LANGCHAIN_API_KEY=lsv2_pt_your-api-key-here

# Habilitar trazado (false para desarrollo normal, true para debugging)
# LANGCHAIN_TRACING_V2=false

# Nombre del proyecto para organizar trazas
# LANGCHAIN_PROJECT=finadvisor-local

# Endpoint de LangSmith
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Evaluación Judge en tiempo real (NO RECOMENDADO - duplica costos)
# ENABLE_JUDGE_EVAL=false

# =============================================================================
# 🛡️ GUARDRAILS (Local Development)
# =============================================================================
# Provider: local (development) or bedrock (requires AWS credentials)
GUARDRAILS_PROVIDER=local

# AWS Bedrock Guardrails (only if GUARDRAILS_PROVIDER=bedrock)
# AWS_BEDROCK_GUARDRAIL_ID=your-guardrail-id-here
# AWS_BEDROCK_GUARDRAIL_VERSION=DRAFT

# =============================================================================
# 📝 INSTRUCCIONES DE USO
# =============================================================================
# 1. Copia este archivo: cp .env.local.example .env.local
# 2. Obtén tu OPENAI_API_KEY de https://platform.openai.com/api-keys
# 3. Pega tu API key en la variable OPENAI_API_KEY
# 4. (Opcional) Configura LangSmith para trazabilidad
# 5. Ejecuta: make run-local
# 6. Abre: http://localhost:8501
