# =============================================================================
# FinAdvisor - AWS CLOUD DEPLOYMENT ENVIRONMENT
# =============================================================================
# Copy this file to .env.cloud and update the values
# This file contains ALL the variables needed for CDK deployment
#
# NOTA: PostgreSQL y Redis son manejados automáticamente por el CDK Stack.
#       Solo necesitas configurar el modelo LLM y LangSmith.
#
# USAGE:
#   cp .env.cloud.example .env.cloud
#   # Edita .env.cloud con tus valores
#   export $(cat .env.cloud | xargs)
#   cd infra && cdk deploy

# =============================================================================
# 🤖 CONFIGURACIÓN DEL MODELO LLM (Requerido)
# =============================================================================

# Provider: bedrock (recomendado para producción), anthropic, openai
MODEL_PROVIDER=bedrock

# AWS Region para CDK deployment (debe tener acceso a modelos Claude habilitado)
# NOTA: Esta variable es usada por CDK durante el deployment.
#       Los Lambda functions reciben AWS_REGION automáticamente del runtime.
AWS_REGION=us-east-1

# Modelo según el provider:
# - Bedrock: anthropic.claude-3-5-sonnet-20241022-v2:0 (recomendado)
#            anthropic.claude-3-5-haiku-20241022-v1:0 (más económico)
#            anthropic.claude-3-opus-20240229-v1:0 (más potente)
# - Anthropic: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
# - OpenAI: gpt-4o, gpt-4o-mini, gpt-4-turbo
MODEL_NAME=anthropic.claude-3-5-sonnet-20241022-v2:0

# =============================================================================
# 🔑 API KEYS (Solo si NO usas Bedrock)
# =============================================================================

# Opción 1: OpenAI (si MODEL_PROVIDER=openai)
# OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Opción 2: Anthropic Direct API (si MODEL_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# =============================================================================
# 📊 LANGSMITH - TRAZABILIDAD EN PRODUCCIÓN (Opcional pero recomendado)
# =============================================================================
# Obtén tu API key desde https://smith.langchain.com/settings

# Requerido: Tu API key de LangSmith
LANGCHAIN_API_KEY=lsv2_pt_your-api-key-here

# Habilitar trazado en producción (true para monitorear todas las conversaciones)
LANGCHAIN_TRACING_V2=true

# Nombre del proyecto en LangSmith
LANGCHAIN_PROJECT=finadvisor-production

# Endpoint de LangSmith (usualmente no necesita cambio)
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Evaluación Judge en tiempo real
# ADVERTENCIA: Duplica las llamadas LLM (aumenta costos)
# Dejar en false para producción
ENABLE_JUDGE_EVAL=true

# =============================================================================
# 🛡️ GUARDRAILS CONFIGURATION
# =============================================================================

# Provider: bedrock (usa AWS Bedrock Guardrails) o local (validación local)
GUARDRAILS_PROVIDER=bedrock

# AWS Bedrock Guardrail Version (DRAFT o número de versión)
# DRAFT permite modificaciones sin crear nueva versión
AWS_BEDROCK_GUARDRAIL_VERSION=DRAFT

# =============================================================================
# 📝 NOTAS IMPORTANTES
# =============================================================================
#
# ✅ Variables que CDK maneja automáticamente (NO configurar aquí):
#    - DB_HOST, DB_PORT, DB_NAME, DB_USER (RDS PostgreSQL endpoint)
#    - REDIS_HOST, REDIS_PORT (ElastiCache Redis endpoint)
#    - AWS_BEDROCK_GUARDRAIL_ID (creado por el stack automáticamente)
#
# ✅ AWS Credentials para Lambda:
#    - El Lambda Execution Role tiene permisos automáticos para Bedrock
#    - NO necesitas configurar AWS_ACCESS_KEY_ID ni AWS_SECRET_ACCESS_KEY
#    - AWS_REGION se proporciona automáticamente por el runtime de Lambda
#
# ✅ Para deployar:
#    1. Asegúrate de tener credenciales de AWS configuradas localmente
#       (aws configure o variables de entorno temporales)
#    2. Configura tus valores en .env.cloud
#    3. Exporta las variables: export $(cat .env.cloud | xargs)
#    4. Deploy: cd infra && cdk deploy
#
# ✅ Configuraciones recomendadas por entorno:
#
#    DESARROLLO/TESTING:
#    - MODEL_PROVIDER=bedrock
#    - MODEL_NAME=anthropic.claude-3-5-haiku-20241022-v1:0 (más barato)
#    - LANGCHAIN_TRACING_V2=true (para debugging)
#
#    PRODUCCIÓN:
#    - MODEL_PROVIDER=bedrock
#    - MODEL_NAME=anthropic.claude-3-5-sonnet-20241022-v2:0 (mejor calidad)
#    - LANGCHAIN_TRACING_V2=true (para monitoreo)
#    - GUARDRAILS_PROVIDER=bedrock (cumplimiento automático)
#
# ✅ Monitoreo:
#    - Todas las conversaciones en producción se trazarán en LangSmith
#    - Ve a https://smith.langchain.com para ver el dashboard
#    - Revisa el proyecto configurado en LANGCHAIN_PROJECT
