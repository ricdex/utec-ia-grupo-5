# FinAdvisor Configuration
# Copy this file to .env and set your values

# ============================================================
# ANTHROPIC API
# ============================================================
# Required: Get your API key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# ============================================================
# MODEL CONFIGURATION
# ============================================================
# Choose your model provider and model name

# Provider options:
# - "anthropic" (default, uses Claude via API)
# - "bedrock" (AWS managed service with Claude)
# - "local" (Ollama for local development)
MODEL_PROVIDER=anthropic

# Model name based on provider:

# For Anthropic:
# - claude-3-5-sonnet-20241022 (recommended, balanced)
# - claude-3-5-haiku-20241022 (fast, compact)
# - claude-3-opus-20250219 (most powerful)
MODEL_NAME=claude-3-5-sonnet-20241022

# For local (Ollama):
# - llama2 (default, 4GB)
# - llama2:13b (larger, 7GB)
# - mistral (alternative)
# OLLAMA_BASE_URL=http://localhost:11434
# MODEL_NAME=llama2

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# PostgreSQL connection details

DB_HOST=localhost
DB_PORT=5432
DB_NAME=finadvisor
DB_USER=postgres
DB_PASSWORD=postgres

# ============================================================
# API CONFIGURATION
# ============================================================
# API Server settings

API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# ============================================================
# RAG CONFIGURATION
# ============================================================
# Retrieval-Augmented Generation settings

RAG_ENABLED=true
RAG_EMBEDDING_DIM=384
RAG_SIMILARITY_THRESHOLD=0.3

# ============================================================
# LOGGING
# ============================================================
# Log levels: DEBUG, INFO, WARNING, ERROR, CRITICAL

LOG_LEVEL=INFO

# ============================================================
# STREAMLIT CONFIGURATION
# ============================================================
# Frontend settings

# API endpoint (where backend is running)
API_ENDPOINT=http://localhost:8000

# Streamlit server config (optional)
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_HEADLESS=true

# ============================================================
# AWS BEDROCK (if using Bedrock instead of Anthropic)
# ============================================================
# Only needed if MODEL_PROVIDER=bedrock

# AWS Credentials
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1

# Bedrock model options:
# - anthropic.claude-3-5-sonnet-20241022-v2:0
# - anthropic.claude-3-5-haiku-20241022-v2:0
# - anthropic.claude-opus-20250729-v1:0
# MODEL_NAME=anthropic.claude-3-5-sonnet-20241022-v2:0
