# =============================================================================
# FinAdvisor - Environment Configuration
# =============================================================================
#
# ⚠️  IMPORTANTE: Este archivo ya no se usa directamente.
#
# Ahora usamos archivos separados según el entorno:
#
# 📁 Para DESARROLLO LOCAL (Docker):
#    cp .env.local.example .env.local
#    # Luego edita .env.local y configura tu API key (OpenAI, Bedrock o Anthropic)
#
# 📁 Para DESPLIEGUE EN AWS (Cloud):
#    cp .env.cloud.example .env.cloud
#    # Luego edita .env.cloud y configura el modelo y LangSmith
#
# =============================================================================
#
# Uso rápido:
#
#   make env          # Crea ambos archivos (.env.local y .env.cloud)
#
#   # Desarrollo local:
#   nano .env.local   # Editar con tu API key
#   make quick-start  # Levantar todo localmente
#
#   # Despliegue AWS:
#   nano .env.cloud              # Editar configuración
#   export $(cat .env.cloud | xargs)
#   make deploy-aws              # Desplegar en AWS
#
# =============================================================================
#
# 📚 Documentación:
#    - Desarrollo local: LEVANTAMIENTO_LOCAL.md
#    - Despliegue AWS:   LEVANTAMIENTO_NUBE.md
#
# =============================================================================
