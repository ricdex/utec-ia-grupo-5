# =============================================================================
# FinAdvisor - Environment Configuration
# =============================================================================
# Copy this file to .env and update the values
# For local development, only the LLM API key is required

# =============================================================================
# 🔑 REQUERIDO: LLM API KEY
# =============================================================================
# Opción 1: OpenAI (Para desarrollo local)
# Obtén tu API key en: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Opción 2: Anthropic (Alternativa para producción)
# Obtén tu API key en: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Opción 3: AWS Bedrock (Configuración activa - ver sección AWS BEDROCK abajo)

# =============================================================================
# 🤖 CONFIGURACIÓN DEL MODELO
# =============================================================================
# Provider: openai, anthropic, bedrock
MODEL_PROVIDER=bedrock

# Modelo según el provider:
# - OpenAI: gpt-4o-mini (recomendado), gpt-4o, gpt-4-turbo
# - Anthropic: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
# - Bedrock: anthropic.claude-3-5-sonnet-20241022-v2:0, anthropic.claude-3-5-haiku-20241022-v1:0
MODEL_NAME=anthropic.claude-3-5-sonnet-20241022-v2:0

# Timeout para llamadas LLM (segundos)
API_TIMEOUT=30

# =============================================================================
# 💾 BASE DE DATOS (Configuración Docker - NO CAMBIAR para local)
# =============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=finadvisor
DB_USER=postgres
DB_PASSWORD=postgres

# Redis (Memoria de conversación)
REDIS_HOST=redis
REDIS_PORT=6379

# =============================================================================
# 🌐 API SERVER (Configuración Docker - NO CAMBIAR para local)
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000

# =============================================================================
# 📊 FRONTEND (Streamlit)
# =============================================================================
# URL del backend API (usar localhost desde tu navegador)
API_ENDPOINT=http://localhost:8000

# =============================================================================
# 🔧 CONFIGURACIÓN AVANZADA (Opcional)
# =============================================================================
# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# RAG (Búsqueda semántica de productos)
RAG_ENABLED=true
RAG_EMBEDDING_DIM=384
RAG_SIMILARITY_THRESHOLD=0.3

# =============================================================================
# ☁️ AWS BEDROCK (Solo si usas MODEL_PROVIDER=bedrock)
# =============================================================================
AWS_ACCESS_KEY_ID=your-access-key-here
AWS_SECRET_ACCESS_KEY=your-secret-key-here
AWS_SESSION_TOKEN=your-session-token-here
AWS_REGION=us-east-1

# ============================================================
# EVALUACIÓN LANGSMITH
# ============================================================
# Configuración de LangSmith para evaluación y monitoreo del agente
# Obtén tu API key desde https://smith.langchain.com/settings

# Requerido: Tu API key de LangSmith
LANGCHAIN_API_KEY=lsv2_pt_your-api-key-here

# Habilitar trazado en producción (true para monitorear en la nube)
LANGCHAIN_TRACING_V2=true

# Nombre del proyecto para organizar trazas
LANGCHAIN_PROJECT=finadvisor-production

# Endpoint de LangSmith (usualmente no es necesario cambiar)
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Opcional: Habilitar evaluación Judge en tiempo real (EXPERIMENTAL)
# ADVERTENCIA: Esto duplica las llamadas LLM (aumenta costo y latencia)
# Solo habilitar para testing/debugging, NO en producción
ENABLE_JUDGE_EVAL=false

# INSTRUCCIONES:
# 1. Obtén tu API key: https://smith.langchain.com/settings
# 2. Copia tu key en LANGCHAIN_API_KEY arriba
# 3. Ejecuta: make eval-status para verificar configuración
# 4. Ejecuta: make eval-quick para tu primera evaluación
# 5. Para habilitar tracing en tiempo real: LANGCHAIN_TRACING_V2=true
# 6. Para habilitar judge en producción: ENABLE_JUDGE_EVAL=true (NO RECOMENDADO)

# =============================================================================
# 🛡️ GUARDRAILS CONFIGURATION
# =============================================================================
# Provider: local (development) or bedrock (production)
GUARDRAILS_PROVIDER=local

# AWS Bedrock Guardrails (only if GUARDRAILS_PROVIDER=bedrock)
# Create guardrail via AWS Bedrock Console, then add ID here
# AWS_BEDROCK_GUARDRAIL_ID=your-guardrail-id-here
# AWS_BEDROCK_GUARDRAIL_VERSION=DRAFT

# =============================================================================
# 📝 INSTRUCCIONES DE USO
# =============================================================================
# 1. Copia este archivo: cp .env.example .env
# 2. Obtén tu OPENAI_API_KEY de https://platform.openai.com/api-keys
# 3. Pega tu API key en la variable OPENAI_API_KEY
# 4. Ejecuta: docker-compose up -d
# 5. Abre: http://localhost:8501
